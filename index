<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Taiwan OSINT Monitor</title>
    <!-- 引入 Globe.gl 來達成類似 WorldMonitor 的 3D 地球視覺效果 -->
    <script src="https://unpkg.com/globe.gl"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;600&display=swap');
        
        :root {
            --bg: #050505;
            --panel-bg: rgba(9, 9, 14, 0.75);
            --border: #2a2a35;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --accent: #3b82f6;
            --danger: #ef4444;
            --warning: #f59e0b;
            --success: #10b981;
            --mono: 'JetBrains Mono', monospace;
            --sans: 'Inter', sans-serif;
        }

        body, html {
            margin: 0; padding: 0; height: 100%;
            background-color: var(--bg); color: var(--text);
            font-family: var(--sans); overflow: hidden;
        }

        #globeViz {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
        }

        .ui-layer {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2; pointer-events: none;
            display: flex; flex-direction: column;
        }

        header {
            pointer-events: auto; padding: 12px 24px;
            background: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
            display: flex; justify-content: space-between; align-items: center;
            font-family: var(--mono); border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .logo { font-size: 1.2rem; font-weight: bold; letter-spacing: 2px; color: var(--text); }
        .logo span { color: var(--accent); }
        .sys-status { display: flex; gap: 20px; align-items: center; font-size: 0.85rem; }
        .sys-status .time { color: var(--muted); }
        .sys-status .badge { padding: 4px 8px; background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid var(--success); border-radius: 4px; }

        .dashboard {
            flex: 1; display: flex; justify-content: space-between;
            padding: 24px; box-sizing: border-box; gap: 24px;
            overflow: hidden;
        }

        .panel {
            pointer-events: auto; width: 340px;
            background: var(--panel-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border); border-radius: 8px;
            display: flex; flex-direction: column; box-shadow: 0 4px 30px rgba(0,0,0,0.5);
        }

        .panel-header {
            padding: 12px 16px; background: rgba(255,255,255,0.03);
            border-bottom: 1px solid var(--border); font-family: var(--mono);
            font-size: 0.8rem; font-weight: bold; color: var(--muted);
            letter-spacing: 1px; text-transform: uppercase;
        }

        .panel-content {
            padding: 16px; flex: 1; overflow-y: auto;
            scrollbar-width: thin; scrollbar-color: #334155 transparent;
        }

        /* Widgets */
        .widget {
            background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.05);
            border-radius: 6px; padding: 12px; margin-bottom: 12px;
            display: flex; justify-content: space-between; align-items: center;
        }
        .widget-label { font-size: 0.8rem; color: var(--muted); font-family: var(--mono); }
        .widget-val { font-size: 1.1rem; font-family: var(--mono); font-weight: bold; }
        
        .feed-item {
            margin-bottom: 16px; padding-bottom: 16px;
            border-bottom: 1px dashed rgba(255,255,255,0.1);
        }
        .feed-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .feed-meta { font-family: var(--mono); font-size: 0.75rem; color: var(--accent); margin-bottom: 6px; display: flex; justify-content: space-between; }
        .feed-title { font-size: 0.9rem; line-height: 1.5; color: #cbd5e1; }
        .feed-title a { color: inherit; text-decoration: none; }
        .feed-title a:hover { color: #fff; text-decoration: underline; }

        .tag { font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; background: #333; color: #fff; }
        .tag.alert { background: rgba(239,68,68,0.2); color: var(--danger); border: 1px solid var(--danger); }
        
    </style>
</head>
<body>

    <!-- 3D 地球背景 -->
    <div id="globeViz"></div>

    <!-- UI 控制面板疊層 -->
    <div class="ui-layer">
        <header>
            <div class="logo">TW-OSINT<span> // MONITOR</span></div>
            <div class="sys-status">
                <div class="time" id="utc-clock">00:00:00 UTC</div>
                <div class="badge">● SYSTEM NOMINAL</div>
            </div>
        </header>

        <div class="dashboard">
            <!-- 左側：即時新聞情報 (SIGINT) -->
            <div class="panel">
                <div class="panel-header">SIGINT / NEWS FEED</div>
                <div class="panel-content" id="news-feed">
                    <div style="text-align: center; color: var(--muted); font-family: var(--mono); margin-top: 20px;">
                        [ INITIALIZING SAT-LINK... ]
                    </div>
                </div>
            </div>

            <!-- 右側：區域數據儀表板 (Telemetry) -->
            <div class="panel">
                <div class="panel-header">REGIONAL TELEMETRY</div>
                <div class="panel-content">
                    
                    <div class="widget">
                        <div class="widget-label">TAIEX IDX</div>
                        <div class="widget-val" id="taiex" style="color: var(--success)">22,431.50</div>
                    </div>
                    
                    <div class="widget">
                        <div class="widget-label">DEFCON</div>
                        <div class="widget-val" style="color: var(--success)">4</div>
                    </div>
                    
                    <div class="widget">
                        <div class="widget-label">ADIZ STATUS</div>
                        <div class="widget-val" style="color: var(--warning)">MONITORING</div>
                    </div>

                    <div class="panel-header" style="padding: 12px 0; margin-top: 10px; background: transparent;">SEISMIC SENSORS (USGS)</div>
                    <div id="eq-feed">
                        <div style="font-size: 0.8rem; color: var(--muted); font-family: var(--mono); text-align: center; margin-top: 20px;">
                            [ SCANNING SEISMIC DATA... ]
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        // 1. 初始化 3D 地球 (使用 Globe.gl)
        const globe = Globe({ animateIn: true })
            (document.getElementById('globeViz'))
            .globeImageUrl('https://unpkg.com/three-globe/example/img/earth-dark.jpg')
            .bumpImageUrl('https://unpkg.com/three-globe/example/img/earth-topology.png')
            .backgroundColor('#050505')
            .pointOfView({ lat: 23.5, lng: 121, altitude: 0.8 }, 2000); // 聚焦台灣

        // 在台灣及周邊建立動態光圈標記 (模擬雷達/感測器)
        const rings = [
            { lat: 25.033, lng: 121.565, maxR: 1.5, propagationSpeed: 1, repeatPeriod: 1000 }, // 台北
            { lat: 22.627, lng: 120.301, maxR: 1.5, propagationSpeed: 1, repeatPeriod: 1500 }, // 高雄
            { lat: 24.813, lng: 120.967, maxR: 1.0, propagationSpeed: 1, repeatPeriod: 1200 }  // 新竹
        ];
        
        globe
            .ringsData(rings)
            .ringColor(() => '#3b82f6')
            .ringMaxRadius('maxR')
            .ringPropagationSpeed('propagationSpeed')
            .ringRepeatPeriod('repeatPeriod');
            
        // 限制縮放與平移，保持視角在亞太區域
        globe.controls().minDistance = 50;
        globe.controls().maxDistance = 300;
        globe.controls().enablePan = false;
        globe.controls().autoRotate = true;
        globe.controls().autoRotateSpeed = 0.3;

        // 2. 即時 UTC 時鐘
        function updateClock() {
            document.getElementById('utc-clock').innerText = new Date().toISOString().replace('T', ' ').substring(0, 19) + ' Z';
        }
        setInterval(updateClock, 1000);
        updateClock();

        // 3. 抓取開源新聞情報 (透過 rss2json 讀取 Google News 台灣焦點)
        async function fetchIntel() {
            try {
                const rssUrl = encodeURIComponent('https://news.google.com/rss/search?q=Taiwan+military+OR+economy&hl=en-US&gl=US&ceid=US:en');
                const res = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${rssUrl}`);
                const data = await res.json();
                
                const container = document.getElementById('news-feed');
                container.innerHTML = '';
                
                // 取前 6 筆新聞
                data.items.slice(0, 6).forEach(item => {
                    const timeStr = new Date(item.pubDate).toISOString().substring(5,16).replace('T', ' ');
                    container.innerHTML += `
                        <div class="feed-item">
                            <div class="feed-meta">
                                <span>[${timeStr}]</span>
                                <span class="tag">OSINT</span>
                            </div>
                            <div class="feed-title">
                                <a href="${item.link}" target="_blank">${item.title}</a>
                            </div>
                        </div>
                    `;
                });
            } catch(e) {
                document.getElementById('news-feed').innerHTML = '<span style="color:var(--danger)">ERR_FEED_OFFLINE</span>';
            }
        }
        fetchIntel();
        setInterval(fetchIntel, 300000); // 每 5 分鐘更新一次

        // 4. 抓取地震數據 (使用 USGS 官方 API，過濾台灣周邊的 Bounding Box)
        async function fetchEq() {
            try {
                const res = await fetch('https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minlatitude=21.0&maxlatitude=26.0&minlongitude=119.0&maxlongitude=123.0&limit=5');
                const data = await res.json();
                const container = document.getElementById('eq-feed');
                container.innerHTML = '';
                
                if (data.features.length === 0) {
                    container.innerHTML = '<div style="color:var(--muted); font-size: 0.8rem; margin-top: 10px;">No recent anomalies.</div>';
                    return;
                }

                data.features.forEach(eq => {
                    const mag = eq.properties.mag;
                    const place = eq.properties.place;
                    const time = new Date(eq.properties.time).toISOString().substring(5,16).replace('T', ' ');
                    
                    let color = 'var(--text)';
                    let tag = '';
                    if(mag >= 4.5) { color = 'var(--danger)'; tag = '<span class="tag alert">ALERT</span>'; }
                    else if(mag >= 3.5) { color = 'var(--warning)'; }

                    container.innerHTML += `
                        <div class="feed-item" style="padding-bottom: 8px; margin-bottom: 8px;">
                            <div class="feed-meta" style="color: ${color}">
                                <span>M ${mag.toFixed(1)} | ${time}</span>
                                ${tag}
                            </div>
                            <div class="feed-title" style="font-size: 0.8rem; color: var(--muted)">${place}</div>
                        </div>
                    `;
                });
            } catch(e) {
                console.error("Earthquake fetch error:", e);
            }
        }
        fetchEq();
        setInterval(fetchEq, 300000);

        // 5. 模擬股市數據 (TAIEX) 跳動，增加動態感
        let baseTaiex = 22431.50;
        setInterval(() => {
            const change = (Math.random() - 0.5) * 15;
            baseTaiex += change;
            const el = document.getElementById('taiex');
            el.innerText = baseTaiex.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            el.style.color = change >= 0 ? 'var(--success)' : 'var(--danger)';
        }, 3500);

    </script>
</body>
</html>
